                "description": "Full-text query string."
              },
              {
                "name": "dsoType",
                "value": "",
                "type": "query",
                "description": "Restrict to a DSpace object type."
              },
              {
                "name": "scope",
                "value": "",
                "type": "query",
                "description": "UUID of a community or collection to scope the search to."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Zero-based page index."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Page size."
              }
            ]
          },
          "docs": "Public discovery search over indexed objects (items, collections, communities). Returns a paged HAL search result whose hits embed the matching indexableObject."
        }
      ]
    }
  ],
  "bundled": true
